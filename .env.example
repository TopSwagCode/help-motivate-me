# Copy to .env, replace both required values, then protect it with chmod 600.
SINGLE_USER_USERNAME=your-username
SINGLE_USER_PASSWORD=replace-with-a-long-random-password
SINGLE_USER_DISPLAY_NAME=
PORT=8080

# Optional AI. All AI controls are hidden when neither key is supplied.
# OpenAI defaults: set only AI_API_KEY to get started.
AI_API_KEY=
AI_PROVIDER=OpenAI
AI_BASE_URL=https://api.openai.com/v1/
AI_CHAT_MODEL=gpt-4.1-mini
AI_ENABLE_TRANSCRIPTION=true
AI_TRANSCRIPTION_MODEL=whisper-1

# Cost estimates used by the built-in AI budget limits. Adjust for the selected model.
AI_INPUT_COST_PER_1M_TOKENS=0.40
AI_OUTPUT_COST_PER_1M_TOKENS=1.60
AI_TRANSCRIPTION_COST_PER_MINUTE=0.006

# OpenAI-compatible vendor example (replace values with your vendor's endpoint/models):
# AI_PROVIDER=OpenRouter
# AI_BASE_URL=https://openrouter.ai/api/v1/
# AI_CHAT_MODEL=openai/gpt-4.1-mini
# AI_ENABLE_TRANSCRIPTION=false
# AI_TRANSCRIPTION_MODEL=

# Legacy fallback for existing installations. Prefer AI_API_KEY for new setups.
OPENAI_API_KEY=
