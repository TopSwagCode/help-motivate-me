{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SingleUser": {
    "Username": "",
    "Password": "",
    "DisplayName": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/data/helpmotivateme.db;Foreign Keys=True;Default Timeout=30"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "AI": {
    "Provider": "OpenAI",
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1/",
    "ChatModel": "gpt-4.1-mini",
    "EnableTranscription": true,
    "TranscriptionModel": "whisper-1",
    "InputCostPer1MTokens": 0.40,
    "OutputCostPer1MTokens": 1.60,
    "TranscriptionCostPerMinute": 0.006
  },
  "OpenAI": {
    "ApiKey": ""
  },
  "LocalStorage": {
    "BasePath": "/data/uploads",
    "BaseUrl": "/api/files"
  },
  "AiBudget": {
    "GlobalLimitLast30DaysUsd": 5.0,
    "PerUserLimitLast30DaysUsd": 0.25
  }
}
